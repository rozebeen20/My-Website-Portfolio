# === Contact Backend Environment Variables ===
# Copy this file to server/.env and fill in your own values.
# Never commit the real server/.env file to version control.

# The inbox your contact form submissions are delivered to.
# This is fixed server-side; visitors can never change the recipient.
EMAIL_TO=rozebeen.20@gmail.com

# The Gmail account used to send the email (must own the app password below).
# It is also the default sender if EMAIL_FROM is not set.
GMAIL_USER=you@gmail.com

# Your 16-character Gmail App Password (NOT your normal account password).
# Generate one at: https://myaccount.google.com/apppasswords
# You must have 2-Step Verification enabled on the Gmail account first.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: the "From" address/identity shown on the email.
# If left empty, GMAIL_USER is used.
EMAIL_FROM=

# The deployed front-end origin, e.g. https://your-portfolio.com
# Used for CORS when the site and API are hosted on separate origins.
# The dev front-end (http://localhost:5173) is always allowed by default.
FRONTEND_URL=

# Port the backend listens on locally (default: 3001).
PORT=3001